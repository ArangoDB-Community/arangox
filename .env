# Default compose profiles: both server lines, so a plain
# `docker compose up --detach --wait` starts the full stack. CI sets
# COMPOSE_PROFILES in the job environment (which overrides this file) to start
# only the leg under test. The image tag default lives in docker-compose.yml,
# not here — deleting this file must never change which server runs.
COMPOSE_PROFILES=3.12,3.11
